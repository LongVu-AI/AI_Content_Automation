        "jsCode": "const response = $input.first().json;\nconst items = response.data?.items || [];\n\n// Chỉ lấy item có status = PENDING_REVIEW\nreturn items\n  .filter(item => item.status === \"PENDING_REVIEW\")\n  .map(item => ({ json: item }));"
