      "parameters": {
        "jsCode": "// Lấy payload từ webhook\nconst payload = $input.first().json.body;\n\n// Validate required fields\nif (!payload.request_id) {\n  throw new Error(\"Missing request_id\");\n}\nif (!payload.status) {\n  throw new Error(\"Missing status\");\n}\nif (!payload.ai_result) {\n  throw new Error(\"Missing ai_result\");\n}\n\n// Transform để gửi sang FastAPI\nreturn [{\n  json: {\n    request_id: payload.request_id,\n    status: payload.status,\n    ai_result: {\n      hook_text: payload.ai_result.hook_text || null,\n      voice_over_text: payload.ai_result.voice_over_text || null,\n      text_on_screen: payload.ai_result.text_on_screen || null,\n      image_prompt_en: payload.ai_result.image_prompt_en || null,\n      bgm_vibe: payload.ai_result.bgm_vibe || null,\n      post_caption: payload.ai_result.post_caption || null,\n      hashtags: payload.ai_result.hashtags || [],\n      qc_score: payload.ai_result.qc_score || 0,\n      qc_feedback: payload.ai_result.qc_feedback || null,\n      retry_count: payload.ai_result.retry_count || 0\n    },\n    metadata: payload.metadata || {},\n    error: payload.error || null\n  }\n}];"
      },
