      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01002",
      "name": "Get Scheduled Due"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst items = response.data?.items || [];\nif (!items.length) {\n  return [];\n}\nconst publishable = items.filter(item => item.status === 'SCHEDULED' || item.status === 'APPROVED');\nreturn publishable.map(item => ({\n  json: {\n    ...item,\n    check_count: 0\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01003",
      "name": "Code Filter Scheduled"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01004",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-service:8000/api/v1/tiktok/publish-from-url",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"request_id\": \"{{ $('Loop Over Items').item.json.request_id }}\",\n  \"video_url\": \"{{ $('Loop Over Items').item.json.video_url }}\",\n  \"title\": \"{{ $('Loop Over Items').item.json.product_name || 'AI TikTok Video' }}\",\n  \"privacy_level\": \"SELF_ONLY\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        -96
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01005",
      "name": "POST Publish From URL"
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        -96
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01006",
      "name": "Wait 60s"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-service:8000/api/v1/tiktok/check-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"request_id\": \"{{ $('Loop Over Items').item.json.request_id }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1320,
        -96
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01007",
      "name": "POST Check Status"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.data?.new_status }}",
              "rightValue": "PUBLISHED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1540,
        -96
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01008",
      "name": "IF Status Published"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1760,
        -192
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01009",
      "name": "NoOp - Published"
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        0
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01010",
      "name": "Wait 30s"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst checkCount = (item.check_count || 0) + 1;\nif (checkCount >= 5) {\n  return [{ json: { ...item, check_count: checkCount, max_reached: true } }];\n}\nreturn [{ json: { ...item, check_count: checkCount, max_reached: false } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "id": "8a35c24b-32bf-412e-8483-e18e80a01011",
      "name": "Code Retry Counter"
    }
